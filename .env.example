# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub (está no .gitignore).

# Endpoint do PROJETO no Microsoft Foundry (página inicial / visão geral do projeto)
# Formato: https://<recurso>.services.ai.azure.com/api/projects/<projeto>
FOUNDRY_PROJECT_ENDPOINT=

# Nome do agente no Foundry (o nome que aparece na página do agente)
FOUNDRY_AGENT_NAME=

# (Opcional) versão fixa do agente. Vazio = usa a versão mais recente.
FOUNDRY_AGENT_VERSION=

# Porta local do servidor
PORT=3000

# Tempo máximo (ms) esperando o agente responder
AGENT_TIMEOUT_MS=60000

# Tamanho máximo da mensagem do usuário (caracteres)
MAX_MESSAGE_LENGTH=1000

# Mensagens por minuto por usuário (controle de custos)
RATE_LIMIT_PER_MINUTE=20

# Só para publicar online (login por service principal). No PC, use "az login" e deixe em branco.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
